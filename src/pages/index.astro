---
import BaseLayout from '../layouts/BaseLayout.astro';

const APP = 'https://client.archlab.pro';
const SIGNUP = `${APP}/signup`;
const PRICING = `${APP}/pricing`;
const SITE = 'https://archlab.pro';

// Single source of truth for the on-page FAQ + the FAQPage schema.
const faqs = [
  {
    q: 'What does ArchLab do?',
    a: "ArchLab is an accuracy-first AI platform for architects. The live product turns hand-drawn sketches and concept images into photorealistic architectural renders in seconds. Extracting real dimensions from site photos, plus CAD and BIM export, are on the roadmap.",
  },
  {
    q: 'Can I use ArchLab today?',
    a: "Yes. The sketch-to-render product is live — you can sign up and start rendering right away. New capabilities are released iteratively, so joining the waitlist gets you early access to upcoming features and a say in what ships next.",
  },
  {
    q: 'How is ArchLab different from generative AI tools like Midjourney?',
    a: "Generative image tools predict what a space should look like and often invent dimensions, proportions and details. ArchLab is built accuracy-first: renders are generated to respect your real proportions, and our upcoming extraction tools derive measurements from geometry rather than guessing. Generic AI imagines spaces; ArchLab measures them.",
  },
  {
    q: 'What can I upload to create a render?',
    a: "Hand-drawn sketches, concept images, and model screenshots from tools like SketchUp, Revit or Rhino. ArchLab accepts common formats including JPEG, PNG, WebP, HEIC (iPhone photos) and PDF.",
  },
  {
    q: 'How much does ArchLab cost?',
    a: "Current plans are on our pricing page, and waitlist members receive founding-member pricing on upcoming features. For firms, we offer an evaluation on one of your real projects.",
  },
  {
    q: 'What is on the ArchLab roadmap?',
    a: "Sketch-to-render is live today. Next is photo-to-dimension extraction, followed by editable CAD export (DXF/DWG), 3D, Revit and BIM/IFC outputs, and later interior design and decoration. ArchLab is developed iteratively with close input from early users.",
  },
  {
    q: 'Where is ArchLab based?',
    a: "ArchLab is built by ArchLab AI S.R.L., based in Arad, Romania, working with architecture partners internationally.",
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ArchLab',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web browser',
  url: SITE,
  description:
    'AI that turns hand-drawn architectural sketches into photorealistic renders with true-to-life proportions. Accuracy-first architecture AI for architects and designers.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: PRICING },
  publisher: {
    '@type': 'Organization',
    name: 'ArchLab AI',
    address: { '@type': 'PostalAddress', addressLocality: 'Arad', addressCountry: 'RO' },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="AI Sketch to Render for Architects — ArchLab"
  description="Turn hand-drawn sketches into photorealistic architectural renders in seconds. ArchLab is the accuracy-first AI for architects — with photo-to-dimension extraction, CAD and BIM export on the roadmap."
  keywords="ai for architects, sketch to render, sketch to render ai, architectural rendering, ai architecture, ai architectural rendering"
  ogImage="/assets/render-after.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <span class="section-label">Live now — AI Sketch to Render</span>
          <h1>Turn a Hand Sketch into a Photorealistic <span class="text-gradient">Architectural Render</span></h1>
          <p>ArchLab is the accuracy-first AI for architects. The live product turns rough sketches and concept images into photorealistic renders in seconds — the first step toward one precise pipeline from concept to construction.</p>
          <div class="hero-buttons">
            <a href={SIGNUP} class="btn btn-primary">Start rendering <span aria-hidden="true">&rarr;</span></a>
            <a href="#how" class="btn btn-ghost">See how it works</a>
          </div>
          <p class="hero-note">Photorealistic renders in seconds</p>
        </div>
        <div class="hero-visual">
          <div class="ba-slider" id="heroSlider">
            <img src="/assets/sketch-before.webp" alt="Hand-drawn architectural sketch before AI rendering" class="ba-before" draggable="false">
            <img src="/assets/render-after.webp" alt="Photorealistic architectural render generated from a sketch" class="ba-after" draggable="false">
            <div class="ba-handle" id="heroHandle"></div>
            <span class="ba-label ba-label-before">Sketch</span>
            <span class="ba-label ba-label-after">Render</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar">
    <div class="container">
      <p>Developed in partnership with</p>
      <div class="trust-logos">
        <a href="https://c3darchitects.com/" target="_blank" rel="noopener"><img src="/assets/c3d-logo.webp" alt="C3D Architects" width="300" height="149" loading="lazy"></a>
        <a href="https://webwispuk.com" target="_blank" rel="noopener"><img src="/assets/Webwisp-logo-Black.webp" alt="WebWisp" width="499" height="249" loading="lazy"></a>
        <a href="https://integranos.com.br/" target="_blank" rel="noopener"><img src="/assets/integranos-logo.svg" alt="Integra.Nos" width="952" height="404" loading="lazy"></a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS (LIVE FEATURE) -->
  <section class="section" id="how">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">How It Works</span>
        <h2 class="section-title">From Sketch to Render in Three Steps</h2>
        <div class="divider"></div>
      </div>
      <div class="steps-grid" style="margin-top:48px;">
        <div class="step-card reveal">
          <div class="step-thumb">
            <img src="/assets/sketch-before.webp" alt="A hand-drawn architectural sketch uploaded to ArchLab" loading="lazy">
          </div>
          <span class="step-number">Step 1 &mdash; Upload</span>
          <h3>Upload Your Sketch or Concept</h3>
          <p>A hand-drawn sketch, a napkin concept, or a model screenshot from SketchUp, Revit or Rhino — ArchLab takes it from here.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-thumb">
            <img src="/assets/ai-interface-render.webp" alt="The ArchLab interface generating a render from a sketch" loading="lazy">
          </div>
          <span class="step-number">Step 2 &mdash; Style</span>
          <h3>Choose a Style and Render</h3>
          <p>Pick a material palette, lighting and mood. ArchLab generates a photorealistic render that respects your proportions — in seconds.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-thumb">
            <img src="/assets/render-after.webp" alt="A finished photorealistic render produced by ArchLab" loading="lazy">
          </div>
          <span class="step-number">Step 3 &mdash; Iterate &amp; Export</span>
          <h3>Refine and Download</h3>
          <p>Adjust by prompt, generate variations, and download high-resolution renders ready for client presentations and pitches.</p>
        </div>
      </div>
      <div class="text-center" style="margin-top:40px;">
        <a href={SIGNUP} class="btn btn-primary">Try it on your sketch <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- ACCURACY WEDGE / COMPARISON -->
  <section class="section section-alt" id="accuracy">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Measured, Not Imagined</span>
        <h2 class="section-title">Renders That Respect Real Dimensions</h2>
        <p class="section-sub">Most AI image tools invent a pretty picture. ArchLab is built so your proportions stay true — a render you can actually design and present from.</p>
      </div>
      <figure class="accuracy-proof reveal">
        <img src="/assets/ai-interface-analysis.webp" alt="ArchLab's analysis step detecting elements and flagging unclear details in a sketch before rendering" loading="lazy">
        <figcaption>When something is ambiguous, ArchLab flags it and asks — instead of inventing a measurement or a detail.</figcaption>
      </figure>
      <div class="compare-grid reveal">
        <div class="compare-col compare-bad">
          <h3>Generic AI image tools</h3>
          <ul>
            <li>Invent dimensions and proportions</li>
            <li>Doors and windows that defy the plan</li>
            <li>Beautiful, but not buildable</li>
            <li>No path to CAD, 3D or BIM</li>
          </ul>
        </div>
        <div class="compare-col compare-good">
          <h3>ArchLab</h3>
          <ul>
            <li>Renders that hold your real proportions</li>
            <li>Built accuracy-first, for architects</li>
            <li>Faithful to your sketch and intent</li>
            <li>The first step toward CAD, 3D and BIM</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Use Cases</span>
        <h2 class="section-title">Built for the Way Architects and Designers Actually Work</h2>
        <div class="divider"></div>
      </div>
      <div class="uc-grid" style="margin-top:48px;">
        <a href="/use-cases/pitch-visuals" class="uc-card reveal">
          <div class="uc-thumb">
            <img src="/assets/render-after.webp" alt="Photorealistic concept render for a client pitch" loading="lazy">
          </div>
          <h3>Pitch &amp; Concept Visuals</h3>
          <p>Win the pitch before your competitor finishes their first sketch. Photorealistic concept renders in seconds.</p>
          <span class="card-link">Learn more &rarr;</span>
        </a>
        <a href="/use-cases/redecoration" class="uc-card reveal">
          <div class="uc-thumb">
            <img src="/assets/generated-interior-placeholder.webp" alt="A redecorated living room render" loading="lazy">
          </div>
          <h3>Room Redecoration</h3>
          <p>Show clients their redesigned room before you move a single piece of furniture.</p>
          <span class="card-link">Learn more &rarr;</span>
        </a>
        <a href="/use-cases/renovation" class="uc-card reveal">
          <div class="uc-thumb">
            <img src="/assets/generated-exterior-placeholder.webp" alt="A renovated modern house exterior render" loading="lazy">
          </div>
          <h3>Renovation Visuals</h3>
          <p>Turn a site photo or rough plan into a clear before-and-after your client can picture instantly.</p>
          <span class="card-link">Learn more &rarr;</span>
        </a>
        <a href="/use-cases/sketch-to-cad" class="uc-card reveal">
          <div class="uc-thumb">
            <img src="/assets/cad-transformation.webp" alt="A sketch transformed into an editable CAD model" loading="lazy">
          </div>
          <h3>Sketch to CAD <span class="uc-soon">Coming soon</span></h3>
          <p>Your napkin sketch becomes a clean, measured, editable CAD file. On the roadmap — join the waitlist for early access.</p>
          <span class="card-link">See the roadmap &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- VISION / ROADMAP -->
  <section class="section section-alt" id="vision">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">The Vision</span>
        <h2 class="section-title">One Precise Pipeline, From Sketch to Building</h2>
        <p class="section-sub">ArchLab is built iteratively, guided by the architects who use it. Our goal: take a hand-drawn sketch all the way to renders, technical blueprints, 3D, Revit and BIM files — every output an architect needs to move a project toward construction. The earlier you join, the more you shape what we build.</p>
      </div>
      <ol class="roadmap reveal">
        <li class="roadmap-item is-live">
          <span class="roadmap-tag">Live now</span>
          <h3>Sketch to Render</h3>
          <p>Photorealistic renders from sketches and concept images, in seconds.</p>
        </li>
        <li class="roadmap-item">
          <span class="roadmap-tag">Next</span>
          <h3>Photo to Dimensions</h3>
          <p>Extract real, technical dimensions from site photos — accuracy, not guesswork.</p>
        </li>
        <li class="roadmap-item">
          <span class="roadmap-tag">Then</span>
          <h3>Editable CAD &amp; Blueprints</h3>
          <p>Clean, layer-separated DXF/DWG you can open in AutoCAD or ArchiCAD.</p>
        </li>
        <li class="roadmap-item">
          <span class="roadmap-tag">Then</span>
          <h3>3D, Revit &amp; BIM</h3>
          <p>Structured 3D and BIM/IFC outputs that drop into your existing workflow.</p>
        </li>
        <li class="roadmap-item">
          <span class="roadmap-tag">Later</span>
          <h3>Interior Design &amp; Decoration</h3>
          <p>Extending the same precise pipeline into interiors and decoration.</p>
        </li>
      </ol>
      <div class="text-center" style="margin-top:40px;">
        <a href="/waitlist" class="btn btn-primary">Join the waitlist — shape what's next <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item reveal"><h3>Seconds</h3><p>Sketch to Render</p></div>
        <div class="stat-item reveal"><h3>0</h3><p>Dimension Hallucinations</p></div>
        <div class="stat-item reveal"><h3>22%</h3><p>Schematic Hours Recovered</p></div>
        <div class="stat-item reveal"><h3>3</h3><p>Architecture Firm Partners</p></div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section testimonial-section">
    <div class="container">
      <div class="testimonial-content reveal">
        <p class="testimonial-quote">What Our Partners Say</p>
        <blockquote>&ldquo;We used ArchLab on a commercial retrofit in Chicago and cut our as-built drafting time from two days to under an hour.&rdquo;</blockquote>
        <cite>&mdash; <strong>Cristian Nicolaie</strong>, C3D Architects</cite>
        <img src="/assets/c3d-logo.webp" alt="C3D Architects" class="testimonial-logo" width="300" height="149" loading="lazy">
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt" id="faq">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="divider"></div>
      </div>
      <div class="accordion reveal" style="margin-top:40px;">
        {faqs.map((f) => (
          <div class="accordion-item">
            <button class="accordion-header">
              <span>{f.q}</span>
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container">
      <div class="final-cta reveal">
        <h2 class="section-title">Start Rendering Today. Help Shape What's Next.</h2>
        <p class="section-sub">Sign up to render your first sketch in seconds — or join the waitlist for early access to dimension extraction, CAD and BIM.</p>
        <div class="hero-buttons">
          <a href={SIGNUP} class="btn btn-primary">Start rendering <span aria-hidden="true">&rarr;</span></a>
          <a href="/waitlist" class="btn btn-ghost">Join the waitlist</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Before/After Slider
    function initSlider() {
      const slider = document.getElementById('heroSlider');
      if (!slider) return;
      const handle = document.getElementById('heroHandle');
      const before = slider.querySelector('.ba-before') as HTMLImageElement;
      let isDragging = false;

      function setPosition(x: number) {
        const rect = slider!.getBoundingClientRect();
        let pct = ((x - rect.left) / rect.width) * 100;
        pct = Math.max(5, Math.min(95, pct));
        before.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
        handle!.style.left = pct + '%';
      }

      slider.addEventListener('mousedown', (e) => { isDragging = true; setPosition(e.clientX); });
      document.addEventListener('mousemove', (e) => { if (isDragging) { e.preventDefault(); setPosition(e.clientX); } });
      document.addEventListener('mouseup', () => { isDragging = false; });

      slider.addEventListener('touchstart', (e) => { isDragging = true; setPosition(e.touches[0].clientX); }, { passive: true });
      document.addEventListener('touchmove', (e) => { if (isDragging) { setPosition(e.touches[0].clientX); } }, { passive: true });
      document.addEventListener('touchend', () => { isDragging = false; });
    }

    initSlider();
  </script>
</BaseLayout>
