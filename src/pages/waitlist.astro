---
import BaseLayout from '../layouts/BaseLayout.astro';

const SIGNUP = 'https://client.archlab.pro/signup';
---

<BaseLayout
  title="Join the Waitlist — Early Access to What's Next | ArchLab"
  description="Sketch-to-render is live. Join the ArchLab waitlist for early access to photo-to-dimension extraction, CAD and BIM — and help shape the roadmap. Founding-member pricing for members."
  keywords="ArchLab waitlist, architecture AI early access, ai for architects"
>
<section class="page-hero">
    <div class="container">
      <span class="section-label">Early Access</span>
      <h1>Get Early Access to <span class="text-gradient">What's Next</span></h1>
      <p>Sketch-to-render is live today. Join the waitlist for early access to what's coming — photo-to-dimension extraction, CAD, 3D and BIM — and help steer what we build. The earlier you join, the more influence you have.</p>
      <p style="margin-top:12px;font-size:0.95rem;">Want to render now? <a href={SIGNUP} style="color:var(--accent);font-weight:600;">Start with sketch to render &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid reveal">
        <div class="form-card">
          <h3 style="color:var(--text-heading-dark);margin-bottom:24px;font-size:1.25rem;">Join the Waitlist</h3>
          <form data-form-type="waitlist">
            <div class="form-group">
              <label for="wl-name">Full Name</label>
              <input type="text" id="wl-name" name="name" class="form-input" placeholder="Your full name" required>
            </div>
            <div class="form-group">
              <label for="wl-email">Email Address</label>
              <input type="email" id="wl-email" name="email" class="form-input" placeholder="you@email.com" required>
            </div>
            <div class="form-group">
              <label for="wl-role">I am a...</label>
              <select id="wl-role" name="role" class="form-select" required>
                <option value="">Select your role</option>
                <option>Architect</option>
                <option>Interior Designer</option>
                <option>Architecture Firm Owner</option>
                <option>Architecture Student</option>
                <option>Real Estate Developer</option>
                <option>Contractor / Builder</option>
                <option>Other</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Join the Waitlist <span aria-hidden="true">&rarr;</span></button>
          </form>
        </div>
        <div>
          <div class="sidebar waitlist-sidebar">
            <h3>What You Get as a Waitlist Member</h3>
            <ul class="benefit-list">
              <li>Early access to new features as they ship</li>
              <li>A say in the roadmap and feature priorities</li>
              <li>Founding-member pricing locked in</li>
              <li>Invitations to private beta testing</li>
              <li>Development updates from the team</li>
            </ul>
            <div class="social-proof-counter">
              <p>Join the architects and designers already helping shape ArchLab's roadmap.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
